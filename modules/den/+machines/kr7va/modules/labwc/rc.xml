<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
  </core>

  <theme>
    <name>osx</name>
    <titlebar>
      <layout>close,iconify,max:</layout>
      <showTitle>no</showTitle>
    </titlebar>
    <cornerRadius>9</cornerRadius>
    <keepBorder>no</keepBorder>
    <maximizedDecoration>titlebar</maximizedDecoration>
    <dropShadows>yes</dropShadows>
  </theme>

  <keyboard>
    <keybind key="F11">
      <action name="ToggleFullscreen" />
    </keybind>
  </keyboard>
</labwc_config>
